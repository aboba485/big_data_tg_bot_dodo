# Environment and App Server
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini
OPENAI_MAX_OUTPUT_TOKENS=3000

# Dodo IS API - Static Token (use either this OR OAuth below)
DODO_ACCESS_TOKEN=your-dodo-access-token
DODO_COUNTRY_ID=ru
DODO_BUSINESS_ID=
DODO_REQUEST_TIMEOUT_SECONDS=40
DODO_MAX_RETRIES=4

# Dodo IS API - OAuth (alternative to static token)
# Set all 4 variables to enable OAuth with automatic token refresh.
# Generate encryption key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DODO_OAUTH_CLIENT_ID=
DODO_OAUTH_CLIENT_SECRET=
DODO_OAUTH_REFRESH_TOKEN=
DODO_TOKEN_ENCRYPTION_KEY=
# Optional: configure daily refresh time (default 03:05 in APP_TIMEZONE)
DODO_TOKEN_REFRESH_HOUR=3
DODO_TOKEN_REFRESH_MINUTE=5

# Unit Configuration
DEFAULT_UNIT_IDS=
UNIT_CATALOG_PATH=data/units.json
UNIT_ALIASES_PATH=data/unit_aliases.json

# Documentation and Storage
DOCUMENTATION_ZIP_PATH=Dodo_IS_API_Reference_Sorted.zip
SQLITE_PATH=data/app.db
REPORTS_DIRECTORY=data/reports

# Retrieval and Planner
RETRIEVAL_TOP_K=6
INDEX_ALL_GET_OPERATIONS=true
ALLOW_ALL_GET_OPERATIONS=true
RAW_DEFAULT_MAX_PERIOD_DAYS=31
RAW_MAX_ROWS=100000
LLM_SUMMARY_ENABLED=false

# Mock Modes (for testing)
DODO_MOCK_MODE=false
PLANNER_MOCK_MODE=false
STORE_USER_QUERIES=true

# Compatibility API (optional web interface)
COMPATIBILITY_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_PUBLIC_ACCESS=true
TELEGRAM_PUBLIC_UNIT_IDS=
ALLOWED_TELEGRAM_IDS=
ADMIN_TELEGRAM_IDS=
TELEGRAM_PRIVATE_CHATS_ONLY=true
TELEGRAM_RATE_LIMIT_PER_MINUTE=10
TELEGRAM_MAX_CONCURRENT_REPORTS_PER_USER=1
TELEGRAM_REPORT_TIMEOUT_SECONDS=120
TELEGRAM_MAX_REPORT_DAYS=366
TELEGRAM_MAX_MESSAGE_ROWS=20
TELEGRAM_FSM_TTL_SECONDS=1800
TELEGRAM_SCHEDULER_POLL_SECONDS=30
TELEGRAM_MAX_WEEKLY_REPORTS_PER_USER=10

# Google Drive / Sheets Integration
# Generate encryption key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
GOOGLE_SHEETS_MAX_ROWS=20000
